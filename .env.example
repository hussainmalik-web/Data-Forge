# Data Forge runtime configuration
# Copy this file to .env for local Docker usage. Never commit .env.

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Upload and profiling limits
MAX_UPLOAD_SIZE_MB=10
PREVIEW_ROWS=25

# Persistent filesystem location for uploaded/cleaned datasets.
# In production, point this at a persistent mounted volume.
STORAGE_DIR=/app/storage

# Comma-separated browser origins allowed to call the API.
# Example: https://data-forge.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time API URL.
VITE_API_URL=http://localhost:8000
